# Normalize line endings: store text as LF in the repo and check out LF on all
# platforms, so Windows checkouts stop warning about LF->CRLF conversion.
* text=auto eol=lf

# Binary assets git should never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.keystore binary
*.jks binary
